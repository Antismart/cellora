{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            l.method,\n            l.path,\n            k.prefix as key_prefix,\n            l.status_code as status,\n            l.latency_ms as ms,\n            l.timestamp\n        FROM api_request_logs l\n        JOIN api_keys k ON l.api_key_id = k.id\n        WHERE k.user_id = $1\n        ORDER BY l.timestamp DESC\n        LIMIT 10\n        ",
