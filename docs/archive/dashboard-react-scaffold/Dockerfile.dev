# Local development image. Mounts the source tree from the host so Vite's
# hot reload works as you edit files. Production image is intentionally not
# defined here — that lands with Week 7 deployment work.
FROM node:22-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.17.1 --activate

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile || pnpm install

COPY . .

EXPOSE 5173

CMD ["pnpm", "dev", "--host", "0.0.0.0"]
